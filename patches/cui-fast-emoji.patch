+/* A glyph found through the font's post names. Apple Color Emoji has no GSUB;
+ * its skin-tone glyphs are morx ligatures named u1F44D.1 (and longer variants
+ * such as u1F469_u2695.2). Try the tone digits at each component boundary,
+ * then the untoned .0 name so a missing variant still shows the base emoji. */
+static int cui__em_post_glyph(const cui__emoji *e, const uint32_t *cps, int n) {
+    if (!e->post_map) return 0;
+    char tok[24][16];
+    int ntok = 0, ntone = 0;
+    char tones[8] = {0}, gender = 0;
+    for (int i = 0; i < n && ntok < 24; i++) {
+        uint32_t c = cps[i];
+        if (c == 0x200D || c == 0xFE0F) continue;
+        if (c == 0x2640) { gender = 'W'; continue; }
+        if (c == 0x2642) { gender = 'M'; continue; }
+        if (c >= 0x1F3FB && c <= 0x1F3FF) {
+            if (ntone < 7) tones[ntone++] = (char)('1' + (c - 0x1F3FB));
+            continue;
+        }
+        int tl = snprintf(tok[ntok], sizeof tok[0], "u%X", (unsigned)c);
+        if (tl <= 0 || tl >= (int)sizeof tok[0]) return 0;
+        ntok++;
+    }
+    tones[ntone] = 0;
+    if (!ntok) return 0;
+    char gs[3] = {0};
+    if (gender) { gs[0] = '.'; gs[1] = gender; }
+
+    for (int pass = 0; pass < 2; pass++) {
+        if (pass == 1 && !ntone) break;
+        const char *ts = pass == 0 ? (ntone ? tones : "0") : "0";
+        for (int cut = 1; cut <= ntok; cut++) {
+            char left[320], right[320];
+            size_t ll = 0, rl = 0;
+            for (int i = 0; i < cut; i++) {
+                if (i && ll + 1 < sizeof left) left[ll++] = '_';
+                size_t tl = strlen(tok[i]);
+                if (ll + tl >= sizeof left) break;
+                memcpy(left + ll, tok[i], tl); ll += tl;
+            }
+            for (int i = cut; i < ntok; i++) {
+                if (i > cut && rl + 1 < sizeof right) right[rl++] = '_';
+                size_t tl = strlen(tok[i]);
+                if (rl + tl >= sizeof right) break;
+                memcpy(right + rl, tok[i], tl); rl += tl;
+            }
+            left[ll] = right[rl] = 0;
+            for (int sep = 0; sep < 2; sep++) {
+                const char *rs = right[0] ? (sep ? "." : "_") : "";
+                char cand[700];
+                int cl = snprintf(cand, sizeof cand, "%s.%s%s%s%s", left, ts, gs, rs, right);
+                int gid = cl > 0 ? cui__em_post_lookup(e, cand, cl) : 0;
+                if (gid) return gid;
+                if (gender) {
+                    cl = snprintf(cand, sizeof cand, "%s.%c.%s%s%s", left, gender, ts, rs, right);
+                    gid = cl > 0 ? cui__em_post_lookup(e, cand, cl) : 0;
+                    if (gid) return gid;
+                }
+            }
+        }
+    }
+    char plain[320];
+    size_t pl = 0;
+    for (int i = 0; i < ntok; i++) {
+        if (i && pl + 1 < sizeof plain) plain[pl++] = '_';
+        size_t tl = strlen(tok[i]);
+        if (pl + tl >= sizeof plain) break;
+        memcpy(plain + pl, tok[i], tl); pl += tl;
+    }
+    plain[pl] = 0;
+    int gid = cui__em_post_lookup(e, plain, (int)pl);
+    if (gid) return gid;
+    if (gender) {
+        char cg[330];
+        int cl = snprintf(cg, sizeof cg, "%s.%c", plain, gender);
+        if (cl > 0) return cui__em_post_lookup(e, cg, cl);
+    }
+    return 0;
+}
