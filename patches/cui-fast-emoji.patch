+/* Apple Color Emoji has no GSUB: its toned variants are morx ligatures whose
+ * post names look like u1F44D.1 or u1F469_u2695.2. Build a name -> glyph map
+ * so the normal sequence lookup can fall back to those glyphs. */
+static void cui__em_post_build(cui_ctx *ui, cui__emoji *e) {
+    if (!e->post || e->post_len < 34) return;
+    const uint8_t *t = e->post;
+    uint32_t L = e->post_len;
+    if (CUI__T32(t, L, 0) != 0x00020000) return;
+    int ng = (int)CUI__T16(t, L, 32);
+    if (ng <= 0) return;
+    const uint8_t *p = t + 34 + (size_t)ng * 2;
+    if (p > t + L) return;
+    uint32_t cap = 16;
+    while (cap < (uint32_t)ng * 2) cap <<= 1;
+    cui__em_post_slot *map = cui__alloc(ui, sizeof *map * cap);
+    if (!map) return;
+    memset(map, 0, sizeof *map * cap);
+    for (int gid = 0; gid < ng; gid++) {
+        uint32_t off = 34 + (uint32_t)gid * 2;
+        if (off + 2 > L) break;
+        if (CUI__T16(t, L, off) < 258) continue;
+        if (p >= t + L) break;
+        uint8_t len = *p;
+        if (p + 1 + len > t + L) break;
+        uint32_t h = 2166136261u;
+        for (int i = 0; i < len; i++) h = (h ^ p[1 + i]) * 16777619u;
+        uint32_t slot = h & (cap - 1);
+        while (map[slot].used) slot = (slot + 1) & (cap - 1);
+        map[slot].used = 1;
+        map[slot].hash = h;
+        map[slot].off = (uint32_t)(p - t);
+        map[slot].gid = (uint16_t)gid;
+        p += 1 + len;
+    }
+    e->post_map = map;
+    e->post_map_n = cap;
+}
