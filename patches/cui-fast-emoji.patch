+/* Look up an exact post name (FNV-1a over the candidate). */
+static int cui__em_post_lookup(const cui__emoji *e, const char *name, int len) {
+    if (!e->post_map || !e->post_map_n || len <= 0) return 0;
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < len; i++) h = (h ^ (unsigned char)name[i]) * 16777619u;
+    uint32_t mask = e->post_map_n - 1, slot = h & mask;
+    for (uint32_t n = 0; n < e->post_map_n; n++) {
+        const cui__em_post_slot *s = &e->post_map[slot];
+        if (!s->used) return 0;
+        if (s->hash == h) {
+            const uint8_t *p = e->post + s->off;
+            if (p[0] == (uint8_t)len && !memcmp(p + 1, name, (size_t)len)) return s->gid;
+        }
+        slot = (slot + 1) & mask;
+    }
+    return 0;
+}
