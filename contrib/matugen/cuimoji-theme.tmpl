# cuimoji theme generated from Matugen's Material You palette.
#
# Install this file as ~/.config/matugen/templates/cuimoji-theme.tmpl and use
# cuimoji-dark.toml / cuimoji-light.toml from this directory. See README.md.
#
# window is the clear area behind the rounded panel and is transparent by
# default. background is the picker panel; surface is a raised layer.
#
# For a translucent panel, replace the background line with:
# background = {{ colors.surface.default.hex | to_color | set_alpha: 0.9 | format: "hex_alpha" }}
# For an opaque clear, uncomment:
# window = {{ colors.surface.default.hex }}

background = {{ colors.surface.default.hex }}
surface = {{ colors.surface_container_high.default.hex }}
surface_muted = {{ colors.surface_container_low.default.hex }}
foreground = {{ colors.on_surface.default.hex }}
text_secondary = {{ colors.on_surface_variant.default.hex }}
text_muted = {{ colors.outline.default.hex }}
border = {{ colors.outline.default.hex }}
border_subtle = {{ colors.outline_variant.default.hex }}
border_strong = {{ colors.on_surface_variant.default.hex }}
accent = {{ colors.primary.default.hex }}
accent_strong = {{ colors.primary.default.hex }}
accent_subtle = {{ colors.primary_container.default.hex }}
accent_foreground = {{ colors.on_primary.default.hex }}
danger = {{ colors.error.default.hex }}
info = {{ colors.secondary.default.hex }}
control_on = {{ colors.primary.default.hex }}
control_glyph = {{ colors.on_primary.default.hex }}
control_track = {{ colors.surface_variant.default.hex }}
control_track_hover = {{ colors.outline.default.hex }}
control_thumb = {{ colors.on_surface.default.hex }}
control_thumb_on = {{ colors.on_primary.default.hex }}
